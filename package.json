{
  "name": "zcode-acp-server",
  "version": "0.1.0",
  "description": "Agent Client Protocol (ACP) server bridging headless ZCode to editors like Zed and JetBrains.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "zcode-acp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "smoke": "node dist/index.js < /dev/null"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
