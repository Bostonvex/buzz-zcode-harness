{
  "name": "buzz-zcode-harness",
  "version": "0.13.0-buzz.1",
  "description": "Buzz-focused ACP bridge for headless ZCode, maintained as an attributed zcode-acp fork.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "ZCode ACP Server Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bostonvex/buzz-zcode-harness.git"
  },
  "homepage": "https://github.com/Bostonvex/buzz-zcode-harness#readme",
  "bugs": {
    "url": "https://github.com/Bostonvex/buzz-zcode-harness/issues"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "zed",
    "jetbrains",
    "coding-agent",
    "llm",
    "zcode"
  ],
  "bin": {
    "zcode-acp": "dist/cli.js",
    "zcode-acp-server": "dist/cli.js",
    "buzz-zcode-harness": "dist/bin/buzz-harness.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "lint": "eslint .",
    "smoke": "node dist/index.js < /dev/null",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@buzz-agent-observability/acp-observer": "https://github.com/Bostonvex/buzz-agent-observability/archive/088634d.tar.gz",
    "chalk": "^6.0.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
